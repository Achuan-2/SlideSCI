{
    "name": "slide-sci-latex-converter",
    "version": "1.0.0",
    "description": "Convert LaTeX formulas to SVG using MathJax for SlideSCI PowerPoint add-in.",
    "private": true,
    "license": "MIT",
    "main": "latex-to-svg.js",
    "scripts": {
        "convert": "node latex-to-svg.js",
        "build:svg": "esbuild mathjax-svg-entry.js --bundle --platform=browser --format=iife --target=es2018 --minify --legal-comments=eof --outfile=mathjax/mathjax-svg.min.js"
    },
    "dependencies": {
        "mathjax-full": "3.2.2"
    },
    "devDependencies": {
        "esbuild": "0.25.12"
    }
}
